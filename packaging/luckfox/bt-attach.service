# Bluetooth on the Luckfox Pico Ultra W (AIC8800DC, H15-38): the BT half talks HCI over /dev/ttyS1.
# Luckfox's recipe (wiki "WIFI-BT"): unblock rfkill, then hciattach at 1.5 Mbaud with flow control.
# The Wi-Fi/BT drivers are loaded by /etc/rc.local (wifi_bt_init.sh), hence After=rc-local.
[Unit]
Description=Attach the AIC8800DC Bluetooth controller (hci0)
After=rc-local.service
Before=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for r in /sys/class/rfkill/*; do [ "$(cat $r/type)" = bluetooth ] && echo 0 > $r/soft; done; true'
ExecStart=/usr/bin/hciattach -n -s 1500000 /dev/ttyS1 any 1500000 flow nosleep
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
