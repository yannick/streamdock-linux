{
  "name": "streamdock-web",
  "private": true,
  "type": "module",
  "description": "React islands for the streamdockd web UI; built by crates/streamdockd/build.rs and embedded in the binary",
  "scripts": {
    "build": "node scripts/check-tokens.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "gen": "buf generate --template buf.gen.yaml",
    "test": "vitest run",
    "check:tokens": "node scripts/check-tokens.mjs",
    "lint": "eslint --max-warnings 0 ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@eslint/js": "9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "^7.3.7",
    "vitest": "5.0.3"
  }
}
